# AutoMark environment configuration — DO NOT COMMIT (contains secrets)
# Supabase project
SUPABASE_REF=YOUR_REF
SUPABASE_URL=https://YOUR_REF.supabase.co
# Publishable (anon) key — safe for the browser when RLS is on
SUPABASE_PUBLISHABLE_KEY=<your-supabase_publishable_key>
# Secret (service-role) key — SERVER ONLY, never send to a browser
SUPABASE_SECRET_KEY=<your-supabase_secret_key>

# Data backend: "json" (local file, default) or "supabase" (REST Data API)
AUTOMARK_DB=supabase

# --- LLM for scenario understanding (Contract C). Leave provider empty to use
# the offline behavioral+heuristic rubric. Set one of these to enable an LLM. ---
AUTOMARK_LLM_PROVIDER=
# openai-compatible: openai | groq | openrouter | together | (any base_url)
AUTOMARK_LLM_BASE_URL=
AUTOMARK_LLM_API_KEY=<your-automark_llm_api_key>
AUTOMARK_LLM_MODEL=
# --- Postgres (session pooler) for migrations only ---
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.YOUR_REF
SUPABASE_DB_NAME=postgres
SUPABASE_DB_PASSWORD=<your-supabase_db_password>
# Session signing secret (generated)
AUTOMARK_SESSION_SECRET=<your-automark_session_secret>
